---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PortfolioCard from '../components/PortfolioCard.astro';

function toTagList(value: unknown): string[] {
  if (Array.isArray(value)) {
    return value.map((item) => String(item).trim()).filter(Boolean);
  }

  if (typeof value === 'string') {
    return value
      .split(',')
      .map((item) => item.trim())
      .filter(Boolean);
  }

  return [];
}

function toLink(value: unknown): string | null {
  if (Array.isArray(value) && value.length > 0) {
    return String(value[0]);
  }

  if (typeof value === 'string' && value.trim().length > 0) {
    return value.trim();
  }

  return null;
}

const entries = await getCollection('portfolio');
const portfolioItems = entries
  .filter((entry) => !entry.id.toLowerCase().endsWith('readme.md'))
  .map((entry) => ({
    title: entry.data.title || entry.slug,
    description:
      entry.data.description ||
      entry.data.summary ||
      'PLACEHOLDER: Add description or summary in frontmatter.',
    tags: toTagList(entry.data.tags),
    primaryLink: toLink(entry.data.links),
    coverImage: entry.data.coverImage || entry.data.cover || null,
  }));
---

<Layout
  title="Portfolio | Kunal Patil"
  description="Portfolio cards generated from markdown files in the portfolio directory."
>
  <section class="reveal">
    <h1 class="text-3xl font-bold text-slate-50 sm:text-4xl">Portfolio</h1>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-200">
      Generated from markdown in /portfolio. Cards use frontmatter fields including title, description/summary,
      tags, links, and cover image when provided.
    </p>
  </section>

  <section class="stagger mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {portfolioItems.map((item) => (
      <PortfolioCard
        title={item.title}
        description={item.description}
        tags={item.tags}
        primaryLink={item.primaryLink}
        coverImage={item.coverImage}
      />
    ))}
  </section>
</Layout>
