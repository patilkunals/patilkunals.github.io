---
import Layout from '../layouts/Layout.astro';
import ContactLinks from '../components/ContactLinks.astro';
---

<Layout
  title="Contact | Kunal Patil"
  description="Contact information for Kunal Patil."
>
  <section class="hero-panel reveal rounded-3xl p-6 sm:p-8">
    <p class="eyebrow text-sm font-medium uppercase tracking-[0.2em] text-cyan-100">Contact</p>
    <h1 class="mt-2 text-3xl font-bold text-slate-50 sm:text-4xl">Kunal Patil</h1>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-200">
      Reach out for solution architecture, GenAI architecture, enterprise transformation, or technology leadership conversations.
    </p>
  </section>

  <section class="glass-card reveal mt-6 max-w-2xl rounded-2xl p-5 sm:p-6">
    <ContactLinks />
  </section>
</Layout>
