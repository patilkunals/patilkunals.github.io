---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const items = [
  {
    label: 'Email',
    value: 'patilkunals@gmail.com',
    href: 'mailto:patilkunals@gmail.com',
    icon: 'mail',
  },
  {
    label: 'Mobile',
    value: '+91-9423859575',
    href: 'tel:+919423859575',
    icon: 'phone',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/patilkunals',
    href: 'https://www.linkedin.com/in/patilkunals/',
    icon: 'linkedin',
  },
];
---

<ul class={`space-y-3 ${compact ? 'text-sm' : 'text-base'}`} aria-label="Contact information">
  {items.map((item) => (
    <li>
      <a
        href={item.href}
        class="contact-link group flex items-center gap-3 rounded-lg border border-white/15 px-3 py-2.5 transition hover:border-cyan-300/60 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
        target={item.icon === 'linkedin' ? '_blank' : undefined}
        rel={item.icon === 'linkedin' ? 'noreferrer' : undefined}
      >
        <span
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full"
          style="background: rgb(var(--accent-rgb) / 0.14); color: rgb(var(--accent-rgb));"
          aria-hidden="true"
        >
          {item.icon === 'mail' && (
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          )}
          {item.icon === 'phone' && (
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.08 4.18 2 2 0 0 1 4.06 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          )}
          {item.icon === 'linkedin' && (
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.45 20.45h-3.56v-5.58c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.68H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.38 4.27 5.46v6.28ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.53V9H7.1v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0Z"></path>
            </svg>
          )}
        </span>
        <span class="min-w-0">
          <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400">{item.label}</span>
          <span class="block break-words font-medium text-slate-100 group-hover:text-cyan-100">{item.value}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
